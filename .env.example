# CoinGecko public API base — no key needed for the free/public endpoints.
# Copy this file to `.env` if you want to override the default.
VITE_API_BASE=https://api.coingecko.com/api/v3

# PHP + MySQL backend (see /backend). Started with:
#   php -S localhost:8000 -t backend
VITE_BACKEND_URL=http://localhost:8000/api
